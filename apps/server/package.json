    "fastify": "^5.2.0",
    "fastify-openapi-glue": "^4.11.5",
    "fastify-sse-v2": "^4.2.2",
    "ioredis": "^5.4.2",
    "ipaddr.js": "^2.5.0",
    "kysely": "^0.28.0",
