# Signs sign-in tokens and encrypts stored credentials (model keys, connector secrets).
# 32+ random characters, e.g. `openssl rand -base64 48`. Changing it later signs everyone
# out and makes stored credentials unreadable.
APP_SECRET=

POSTGRES_PASSWORD=

# Where the server listens on the host. Keep it on localhost behind a TLS proxy.
BIND=127.0.0.1
PORT=8787

# 0 = new accounts only by invitation.
ALLOW_SIGNUP=1

# 1 = let the server call model gateways and MCP servers on private networks.
ALLOW_PRIVATE_UPSTREAMS=0

# Uploads are staged in a volume by default (fine for one server). With several
# replicas they need a store they share — any S3-compatible one:
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=            (empty for AWS; set for MinIO, R2, OSS…)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=0   (1 for MinIO)

# How long a conversation must be quiet before it is reviewed for what to remember (0 = never).
# The review is one request to the session's model, on the member's key.
# MEMORY_REVIEW_IDLE_SECONDS=60

# The shortest interval an automation may repeat at, in seconds.
# AUTOMATION_MIN_INTERVAL_SECONDS=30

# The Feishu open platform's address, for bots bound to agents. Empty = https://open.feishu.cn.
# Set it for a private Feishu deployment, or to https://open.larksuite.com for Lark.
# FEISHU_API_BASE=

# This server's address as a browser reaches it. Needed for connectors that are signed in to
# (OAuth): it is where people are sent back after signing in. Empty = http://127.0.0.1:<PORT>.
# PUBLIC_URL=https://agents.example.com

# The market index the marketplace reads: addresses tried in order. Empty switches the marketplace off.
# MARKETPLACE_INDEX_URLS=https://api.valuz.cn/cloud,https://api.valuz.io/cloud

# WeCom's long-connection gateway for smart bots. Empty = wss://openws.work.weixin.qq.com.
# WECOM_WS_URL=
