# Signs sign-in tokens and encrypts stored credentials (model keys, connector secrets).
# 32+ random characters, e.g. `openssl rand -base64 48`. Changing it later signs everyone
# out and makes stored credentials unreadable.
APP_SECRET=

POSTGRES_PASSWORD=

# Where the server listens on the host. Keep it on localhost behind a TLS proxy.
BIND=127.0.0.1
PORT=8787

# 0 = new accounts only by invitation.
ALLOW_SIGNUP=1

# 1 = let the server call model gateways and MCP servers on private networks.
ALLOW_PRIVATE_UPSTREAMS=0
