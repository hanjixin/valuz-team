# Signs tokens and encrypts stored credentials (model keys, connector and bucket
# secrets). Generate once: openssl rand -base64 48
# Losing or changing it makes every stored credential unreadable.
APP_SECRET=
POSTGRES_PASSWORD=
# How desktops and browsers reach this server (put TLS in front of it).
PUBLIC_URL=https://agents.example.com
# 0 = invite-only after the first account exists.
ALLOW_SIGNUP=1
CORS_ORIGINS=*
BIND=127.0.0.1
PORT=8787
