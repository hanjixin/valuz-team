{
  "name": "agent-base",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "dev:server": "pnpm --filter @agent-base/server dev",
    "dev:host": "pnpm --filter @agent-base/host dev",
    "dev:web": "pnpm --filter @agent-base/web dev",
    "migrate": "pnpm --filter @agent-base/server migrate",
    "infra:up": "docker compose -f deploy/docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f deploy/docker-compose.dev.yml down"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
